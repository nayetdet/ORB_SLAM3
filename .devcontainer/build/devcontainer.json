{
  "name": "ORB-SLAM3-build",
  "build": {
    "dockerfile": "../docker/Dockerfile",
    "context": "../.."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "username": "vscode"
    },
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "1.3.14"
    }
  },
  "remoteUser": "vscode",
  "overrideCommand": false
}
