{
  "name": "ORB-SLAM3",
  "image": "ghcr.io/nayetdet/orb_slam3:devcontainer",
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",
  "initializeCommand": "bash .devcontainer/scripts/init.sh",
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "remoteUser": "vscode",
  "overrideCommand": false,
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.bun/bin"
  },
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/tmp/.Xauthority",
    "QT_X11_NO_MITSHM": "1"
  },
  "runArgs": [
    "--init",
    "--device=/dev/bus/usb:/dev/bus/usb"
  ],
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.Xauthority,target=/tmp/.Xauthority,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "usernamehw.errorlens",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  }
}
